# =============================================================================
#  Modele de configuration locale
#
#  Copiez ce fichier sous le nom secrets.properties, dans le meme dossier,
#  puis renseignez vos valeurs. Le fichier reel est exclu de Git : vos
#  identifiants ne partiront jamais dans le depot.
#
#      cp secrets.properties.example secrets.properties
#
#  En production, ces memes valeurs sont fournies par des variables
#  d'environnement ou par Secret Manager, jamais par un fichier.
# =============================================================================

# ---------------------------------------------------------------------------
#  Compte administrateur initial
#
#  Il est cree au tout premier demarrage, et uniquement si la base est
#  vide. Une fois le compte en place, modifier ces lignes n'a plus aucun
#  effet : changez votre mot de passe depuis l'application.
#
#  Le mot de passe doit comporter au moins 10 caracteres.
# ---------------------------------------------------------------------------
helpdesk.admin.email=vous@votre-societe.tn
helpdesk.admin.password=CHANGEZ_CE_MOT_DE_PASSE
helpdesk.admin.full-name=Votre Nom

# ---------------------------------------------------------------------------
#  Base de donnees (facultatif en local)
#
#  Par defaut, l'application se connecte a MySQL sur localhost avec
#  l'utilisateur root sans mot de passe, ce qui correspond a XAMPP.
# ---------------------------------------------------------------------------
# spring.datasource.username=root
# spring.datasource.password=

# ---------------------------------------------------------------------------
#  Cle de signature des jetons (facultatif en local)
#
#  Une valeur de developpement est prevue. En production, cette cle est
#  obligatoire et doit etre tiree au hasard :
#      openssl rand -base64 48
# ---------------------------------------------------------------------------
# helpdesk.security.jwt.secret=
